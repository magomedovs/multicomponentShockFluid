FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      H2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

Y_H2_init       0.012772586577715456;
internalField   uniform $Y_H2_init;

boundaryField
{
    leftWall
    {
        type            zeroGradient;
    }
    
    inlet
    {
        // type            zeroGradient;
        type            waveTransmissive;
        gamma           1.4;
        fieldInf        $Y_H2_init;
        lInf            1e2;
    }
    
    emptyWalls
    {
        type            empty;
    }
}

// ************************************************************************* //
