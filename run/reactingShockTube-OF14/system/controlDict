FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          multicomponentShockFluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         23e-5;

deltaT          1e-08;

writeControl    adjustableRunTime;

writeInterval   5e-6;

cycleWrite      0;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.1;

maxDeltaT       1; //2e-8;//1;


// ************************************************************************* //
