FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

p_init          35594;
internalField   uniform $p_init;

boundaryField
{
    leftWall
    {
        type            zeroGradient;
    }
    
    inlet
    {
        // type            fixedValue;
        // value           uniform 35594;

        type            waveTransmissive;
        gamma           1.4;
        fieldInf        $p_init;
        lInf            1e2;
    }
    
    emptyWalls
    {
        type            empty;
    }
}


// ************************************************************************* //
